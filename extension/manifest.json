{
  "manifest_version": 3,
  "name": "Legium",
  "version": "2.3.0",
  "description": "Saves every highlight and note in your notebook (read.amazon.com/notebook) as one file for Legium, as plain JSON, or as notebook files.",
  "homepage_url": "https://github.com/hronirllc/legium-browser-extension",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Export highlights",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "downloads"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://read.amazon.com/notebook*",
        "https://read.amazon.co.uk/notebook*",
        "https://read.amazon.co.jp/notebook*",
        "https://read.amazon.de/notebook*",
        "https://read.amazon.fr/notebook*",
        "https://read.amazon.es/notebook*",
        "https://read.amazon.it/notebook*",
        "https://read.amazon.ca/notebook*",
        "https://read.amazon.com.au/notebook*",
        "https://read.amazon.in/notebook*",
        "https://read.amazon.com.br/notebook*",
        "https://read.amazon.com.mx/notebook*"
      ],
      "js": [
        "notebook.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "legium@hronir.dev",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/hronirllc/legium-browser-extension/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
